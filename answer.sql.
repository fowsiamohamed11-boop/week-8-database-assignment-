-- QUESTION 1: CREATING A COMPLETE DATABASE BACKUP

-- Command:
-- mysqldump -u root -p sales > sales_backup.sql

-- Explanation:
-- This command creates a complete backup of the sales database.
-- -u root specifies the MySQL username.
-- -p prompts for the database password.
-- sales specifies the database to back up.
-- > sales_backup.sql saves the backup in a file.
-- Regular backups help prevent data loss and support recovery
-- if a database becomes damaged or deleted.


-- ==========================================
-- QUESTION 2: BACKING UP ALL DATABASES
-- ==========================================

-- Command:
-- mysqldump -u root -p --all-databases > all_databases_backup.sql

-- Explanation:
-- --all-databases backs up every database on the MySQL server.
-- -u root specifies the MySQL username.
-- -p prompts for the database password.
-- > saves all database backups into one SQL file.
-- Backing up all databases before migration ensures that
-- important data and database structures can be transferred
-- and restored on the new server.


-- ==========================================
-- QUESTION 3: DATA-ONLY DATABASE BACKUP
-- ==========================================

-- Command:
-- mysqldump -u root -p --no-create-info sales > sales_data_backup.sql

-- Explanation:
-- --no-create-info exports data without table creation statements.
-- -u root specifies the MySQL username.
-- -p prompts for the database password.
-- sales specifies the database to back up.
-- This backup contains the data only, without CREATE TABLE statements.

